# Blender binaries — large, and the Buildify-derived ones are not ours to redistribute
*.blend
*.blend1
*.blend2

# Exported / generated geometry
*.obj
*.mtl
*.fbx

# Packaged builds (rebuilt from source by the packaging step)
*.zip

# Python
__pycache__/
*.pyc

# virtual environments -- machine-specific, and hundreds of megabytes
.venv/
venv/
env/

# wizard output: models are rebuilt from the sample layer by wizard.bat
sample/models/
